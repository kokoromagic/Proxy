{
  "manifest_version": 3,
  "name": "Simple Proxy Connector",
  "version": "3.1",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://kokoromagic.github.io/*",
    "https://api.ipify.org/*",
    "http://connectivitycheck.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "earth.png",
      "48": "earth.png",
      "128": "earth.png",
      "512": "earth.png"
    }
  },
  "icons": {
    "16": "earth.png",
    "48": "earth.png",
    "128": "earth.png",
    "512": "earth.png"
  }
}